#!/bin/sh
set -eu

anchors=${1:?usage: remove ANCHORS_DIR fedora|arch}
platform=${2:?usage: remove ANCHORS_DIR fedora|arch}
rm -f "$anchors"/bccr-*.crt
rm -f /var/lib/bccr-certs/bundle.pem \
  /var/lib/bccr-certs/ca-bundle.pem /var/lib/bccr-certs/roots.pem
rm -f /var/lib/bccr-certs/certificates/*.pem \
  /var/lib/bccr-certs/roots/*.crt
rmdir /var/lib/bccr-certs/certificates 2>/dev/null || true
rmdir /var/lib/bccr-certs/roots 2>/dev/null || true
rmdir /var/lib/bccr-certs 2>/dev/null || true

case "$platform" in
  fedora|arch) update-ca-trust extract ;;
  *) echo "error: unsupported trust store: $platform" >&2; exit 2 ;;
esac
