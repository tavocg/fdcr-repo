#!/bin/sh

set -eu

case "${1:-}" in
configure)
  desktop_content=/tmp/fdcr-scmanager.desktop.$$
  trap 'rm -f "$desktop_content"' EXIT HUP INT TERM
  cat >"$desktop_content" <<'EOF'
[Desktop Entry]
Type=Application
Name=SCManager
Comment=Administrador de tarjetas Idopte
Exec=/usr/lib/SCMiddleware/SCManager
Icon=/usr/share/SCMiddleware/application.png
Terminal=false
Categories=Utility;Security;
EOF

  install -D -m 0644 "$desktop_content" /usr/share/applications/SCManager.desktop
  install -D -m 0644 "$desktop_content" /etc/xdg/autostart/SCManager.desktop
  rm -f "$desktop_content"
  trap - EXIT HUP INT TERM
  ;;
esac
